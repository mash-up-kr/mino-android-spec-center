rules_version = '2';
// MASC Storage 보안규칙
// spec 이미지(assets) 업로드는 폐기됐다 — 신 템플릿은 화면 근거를 Figma 노드 URL 로 적고,
// 대시보드는 spec.md 본문만 다룬다. 남은 레거시 파일은 읽기만 허용하고 쓰기는 막는다.
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }

    match /features/{featureId}/assets/{fileName} {
      allow read: if signedIn();  // 과거 업로드분 열람용
      allow write: if false;      // 신규 업로드 경로 없음
    }
  }
}
