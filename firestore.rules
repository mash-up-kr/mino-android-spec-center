rules_version = '2';
// MASC Firestore 보안규칙 — docs/data-model.md §3
// 1차 가드: role·전이 적법성·필드 잠금. 민감 전이(pr_open/merged/pr_closed)는
// Functions(Admin SDK, 규칙 우회)만 설정 가능 — 클라이언트는 위조 불가.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isDeveloper() { return signedIn() && myRole() == 'developer'; }
    function isDesigner()  { return signedIn() && myRole() == 'designer'; }

    // 사용자 프로필 — 본인만 작성, 로그인 사용자는 읽기(리뷰어 이름 표시용)
    // MVP: role 은 온보딩에서 본인이 선택(자체 서명). PR 권한은 GitHub 토큰이 별도 게이트.
    // githubToken 평문 저장 금지 — 토큰은 storeGithubToken(Functions) → Secret Manager.
    // update 는 레거시 필드가 남은 문서의 무관한 갱신은 허용(값 변경만 차단, 이관은 Functions 가 수행).
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if request.auth.uid == uid
        && !('githubToken' in request.resource.data);
      allow update: if request.auth.uid == uid
        && (!('githubToken' in request.resource.data)
            || request.resource.data.githubToken == resource.data.get('githubToken', null));
      allow delete: if false;
    }

    match /features/{featureId} {
      allow read: if signedIn();

      // 생성: 개발자, 본인 명의, 초기 상태 spec_draft, PR 필드 비어있음, base 브랜치 지정,
      //       `/mino-spec` 산출물 2종(spec 본문 + 품질 체크리스트) 모두 첨부
      allow create: if isDeveloper()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'spec_draft'
        && request.resource.data.prNumber == null
        && request.resource.data.baseBranch is string
        && request.resource.data.baseBranch != ''
        && request.resource.data.checklistBody is string
        && request.resource.data.checklistBody != '';

      // ── 필드 잠금 헬퍼 (update 후 문서 request.resource.data vs 기존 resource.data) ──
      function unchanged(f) {
        return request.resource.data.get(f, null) == resource.data.get(f, null);
      }
      // 클라이언트는 prNumber 를 임의값으로 못 넣음: 그대로거나 null(무효화)만
      function prNumberOk() {
        return request.resource.data.get('prNumber', null) == resource.data.get('prNumber', null)
          || request.resource.data.get('prNumber', null) == null;
      }

      // 개발자 허용 상태 전이 (from → to). pr_open/merged/pr_closed 로의 전이는 없음(Functions 전용).
      // plan 검토 단계(plan_drafted) 폐기 — spec_approved 다음은 곧바로 Functions 의 pr_open.
      function devTransitionOk(from, to) {
        return (to == from && from != 'spec_in_review')   // 상태유지 수정(내용/메모) — 검토중은 read-only
          || (to == 'spec_in_review' && (from == 'spec_draft' || from == 'spec_changes_requested'))
          || (to == 'spec_draft' && (from == 'spec_approved' || from == 'pr_open' || from == 'merged'));
      }
      // 디자이너 허용 상태 전이 — 승인/반려/보충코멘트(상태유지)만
      function desTransitionOk(from, to) {
        return (to == 'spec_approved' && from == 'spec_in_review')
          || (to == 'spec_changes_requested' && from == 'spec_in_review')
          || (to == from && (from == 'spec_in_review' || from == 'spec_changes_requested'));
      }
      // 디자이너는 문서 내용 변경 불가 — status·reviews·updatedAt 만 건드림.
      // 품질 체크리스트는 검수 대상이 아니라 개발자 자가검증 산출물이므로 함께 잠근다.
      function desContentLocked() {
        return unchanged('createdBy') && unchanged('slug') && unchanged('title')
          && unchanged('specBody') && unchanged('specVersion') && unchanged('specStatus')
          && unchanged('checklistBody') && unchanged('checklistStatus')
          && unchanged('checklistTargetVersion')
          && unchanged('prdVersion') && unchanged('versionLog')
          && unchanged('baseBranch') && unchanged('figmaSources')
          && unchanged('prNumber') && unchanged('prUrl');
      }

      // 수정:
      //  - 개발자: createdBy 불변 + prNumber 위조 불가 + 적법 전이 (검토중 read-only 는 전이표가 강제)
      //  - 디자이너: createdBy 불변 + 내용 잠금 + 승인/반려/코멘트 전이
      allow update: if
        (isDeveloper() && unchanged('createdBy') && prNumberOk()
          && devTransitionOk(resource.data.status, request.resource.data.status))
        || (isDesigner() && desContentLocked()
          && desTransitionOk(resource.data.status, request.resource.data.status));

      allow delete: if false;

      // 컨펌 이력 서브컬렉션(설계) — 디자이너만 추가, 누구나 읽기, 수정/삭제 불가
      match /reviews/{reviewId} {
        allow read: if signedIn();
        allow create: if isDesigner();
        allow update, delete: if false;
      }
    }

    // ── PRD (P8) — spec 의 상위 문서. docs/design/prd-track.md §8 ──
    // 컨펌 게이트가 없어 상태 전이 허용목록도 없다. 대신 권한이 둘로 갈린다:
    //   문서 = 개발자만 (산출물 파일을 가진 주체) · 논의 = 로그인한 전원
    match /prds/{prdId} {
      allow read: if signedIn();
      allow create, update: if isDeveloper()
        && request.resource.data.uploadedBy == request.auth.uid
        && request.resource.data.version is string
        && request.resource.data.version != ''
        && request.resource.data.body is string
        && request.resource.data.body != '';
      allow delete: if false;

      // 버전 스냅샷 — 문서 id 가 버전 문자열이라 중복 생성이 구조적으로 불가.
      // 갱신/삭제를 막아 감사 기록으로서 불변성을 지킨다.
      match /versions/{version} {
        allow read: if signedIn();
        allow create: if isDeveloper();
        allow update, delete: if false;
      }

      // 논의 — 로그인한 누구나(개발자·디자이너), 본인 명의로만.
      // 삭제는 소프트(deleted:true)만 허용해 스레드 순서를 보존한다.
      match /comments/{msgId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.body is string
          && request.resource.data.body != '';
        allow update: if signedIn()
          && resource.data.authorUid == request.auth.uid
          && request.resource.data.authorUid == resource.data.authorUid
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if false;
      }
    }
  }
}
